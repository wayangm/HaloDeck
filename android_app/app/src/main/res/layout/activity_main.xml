<?xml version="1.0" encoding="utf-8"?>
<!-- Layar utama HaloDeck.
     Susunan atas-ke-bawah:
       1. Baris judul + ikon ⋮
       2. Pil status koneksi (titik warna + teks) dan nama profil aktif
       3. Grid tombol makro (3 kolom, digulir, berkelompok)
     Tidak ada kolom IP di sini lagi — cukup status koneksi saja,
     karena penyambungan sudah otomatis.
     keepScreenOn di root: layar HP tetap menyala saat dipakai sebagai
     remote. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/akar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true"
    android:background="@color/latar_gelap"
    android:fitsSystemWindows="true">

    <!-- 1. Judul -->
    <TextView
        android:id="@+id/teks_judul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:drawablePadding="9dp"
        android:gravity="center_vertical"
        android:drawableStart="@drawable/ic_m_taskmgr"
        android:text="@string/judul"
        android:textColor="@color/teks_utama"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 2. Baris status + profil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Pil status -->
        <LinearLayout
            android:id="@+id/pil_status"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="13dp">

            <View
                android:id="@+id/titik_status"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/aksen_kuning" />

            <TextView
                android:id="@+id/teks_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="@string/status_mencari"
                android:textColor="@color/teks_utama"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Nama profil aktif -->
        <TextView
            android:id="@+id/teks_profil"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pil"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/profil_kosong"
            android:textColor="@color/teks_redup"
            android:textSize="13sp" />

        <!-- Ruang dorong supaya ⋮ menempel di kanan -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Tombol limpahan -->
        <ImageButton
            android:id="@+id/tombol_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_sambung_otomatis"
            android:src="@drawable/ic_menu_limpahan"
            android:tint="@color/teks_redup" />

    </LinearLayout>

    <!-- 3. Grid makro -->
    <ScrollView
        android:id="@+id/gulir_makro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:fadeScrollbars="false"
        android:scrollbarThumbVertical="@color/garis">

        <LinearLayout
            android:id="@+id/wadah_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <GridLayout
                android:id="@+id/grid_makro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
