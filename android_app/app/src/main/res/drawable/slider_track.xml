<?xml version="1.0" encoding="utf-8"?>
<!-- Lintasan (track) slider volume.
     Dua lapis dalam satu layer-list:
       * background : garis abu-abu, bagian yang belum terisi
       * progress   : dipotong <clip> horizontal sehingga hanya melebar
                      sejauh nilai progres -> terlihat "terisi"

     SENGaja TIDAK memakai inset (baik atribut android:top pada <item>
     maupun pembungkus <inset>). Keduanya teruji membuat kedua lapisan
     hilang sama sekali pada perangkat yang diuji: lapisan tidak
     digambar sama sekali sehingga slider tampak tanpa lintasan.

     Penebalan lintasan dicapai lewat padding pada <SeekBar> di
     baris_volume.xml, bukan di sini. ProgressBar bawaan menghitung
     batas progressDrawable-nya dari padding view, sehingga jalur itu
     resmi dan selalu berfungsi. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/garis" />
            <corners android:radius="3dp" />
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip
            android:clipOrientation="horizontal"
            android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/aksen_biru" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>

</layer-list>
