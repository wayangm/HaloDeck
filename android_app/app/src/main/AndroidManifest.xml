<?xml version="1.0" encoding="utf-8"?>
<!-- Manifest aplikasi HaloDeck - Android Native -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin internet: untuk koneksi TCP ke ESP8266 (jalur Wi-Fi cadangan) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Izin status jaringan: DIPERLUKAN untuk registerNetworkCallback
         (pantau koneksi otomatis). Tanpa ini aplikasi gagal start. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Izin multicast: WAJIB agar paket balasan DISCOVER (UDP 8081) dari
         ESP8266 diterima. Android membuang paket multicast/broadcast saat
         Wi-Fi hemat daya bila aplikasi tidak memegang MulticastLock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Catatan: izin lokasi (untuk pindai Wi-Fi) DIHAPUS bersama tombol
         "Atur Wi-Fi" — konfigurasi Wi-Fi kini lewat portal browser ESP. -->

    <application
        android:name=".Aplikasi"
        android:allowBackup="true"
        android:icon="@drawable/ic_logo"
        android:label="@string/nama_aplikasi"
        android:theme="@style/Theme.HaloDeck"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
